# Имя compose-проекта на сервере: trenio-dev или trenio-prod
COMPOSE_PROJECT_NAME=trenio-dev
# Окружение: local, dev или prod (видно в /health)
ENV=dev
# Версия образов. Её записывает deploy.sh, руками не меняй
TRENIO_TAG=
# Порт web на 127.0.0.1, на него смотрит edge nginx: 8080 для dev, 8081 для prod
WEB_PORT=8080
# Порт веб-админки на 127.0.0.1 для edge nginx (поддомен admin.): 8082 для dev, 8083 для prod
ADMIN_PORT=8082

# База в общем PostgreSQL (контейнер trenio-postgres).
# Локально вместо trenio-postgres будет localhost
DATABASE_URL=postgresql+asyncpg://trenio_dev:change-me@trenio-postgres:5432/trenio_dev

# Токен бота от @BotFather (у dev и prod разные боты)
BOT_TOKEN=
# webhook на сервере, polling локально
BOT_MODE=webhook
# Публичный HTTPS-адрес, на который Telegram шлёт webhook
WEBHOOK_BASE_URL=https://trenio.dev.tvpngate.cc
# Случайная строка: Telegram присылает её в заголовке, чужие запросы отбрасываются
WEBHOOK_SECRET=
# HTTPS-адрес Mini App для кнопки в боте
WEBAPP_URL=https://trenio.dev.tvpngate.cc

# Секрет для подписи токенов входа: openssl rand -hex 32
JWT_SECRET=

# Telegram ID админов через запятую. Админ сам тренер и выдаёт доступ другим
# тренерам командой /invite в боте
ADMIN_TELEGRAM_IDS=

# Администрация и оператор персональных данных в политике и соглашении (/privacy и /terms
# в боте, экраны в Mini App, страницы сайта /privacy и /terms): ФИО, статус и ИНН, например
# «Иванов Иван Иванович, самозанятый, ИНН 123456789012», и куда писать: «@username» или e-mail
PRIVACY_OPERATOR=
PRIVACY_CONTACT=

# Platega: оплата подписки Pro по СБП. Ключи в ЛК https://app.platega.io → Настройки.
# Пусто — оплата выключена, тренеры видят цены без кнопки «Оплатить».
# Callback в ЛК Platega: https://<домен>/api/platega/callback (без него статус узнаём опросом)
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
