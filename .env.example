# Окружение: local, dev или prod (видно в /health)
ENV=local

# Подключение к PostgreSQL (значения должны совпадать с compose.yaml)
POSTGRES_USER=trenio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trenio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Адрес базы для приложения. Внутри docker compose хост будет db, а не localhost
DATABASE_URL=postgresql+asyncpg://trenio:change-me@localhost:5432/trenio

# Токен бота от @BotFather
BOT_TOKEN=
# polling, пока нет домена и HTTPS; webhook на сервере
BOT_MODE=polling
# Публичный HTTPS-адрес, на который Telegram шлёт webhook (только для BOT_MODE=webhook)
WEBHOOK_BASE_URL=
# Случайная строка: Telegram присылает её в заголовке, чужие запросы отбрасываются
WEBHOOK_SECRET=
# HTTPS-адрес Mini App для кнопки в боте
WEBAPP_URL=

# Секрет для подписи токенов входа: openssl rand -hex 32
JWT_SECRET=

# Telegram ID тренеров с бета-доступом, через запятую
BETA_TRAINER_IDS=
